pipeline {
    agent any

    triggers {
        cron('0 22 * * *')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'pip install -r requirements.txt'
            }
        }

        stage('Run Playwright') {
            when {
                branch 'master'
            }

            steps {
                bat 'pytest -s Assignment1/Assignment1.py --html=report.html'
            }
        }
    }
}